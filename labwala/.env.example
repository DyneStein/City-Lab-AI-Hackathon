# ── Nuskha configuration ── copy to .env.local and fill in. Never commit real keys.

APP_URL=http://localhost:3000
DATA_DIR=./data

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Encrypts uploaded files, report layouts, explanations and the PII vault.
# (In development a key is auto-generated into DATA_DIR/.dev-key if this is empty.)
DATA_ENCRYPTION_KEY=

# ── AI (any OpenAI-compatible endpoint) ──
# Default: GPT-OSS-120B on Groq's free tier. Get a free key at https://console.groq.com/keys
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
# Alternatives (also free tiers):
#   Cerebras:   AI_BASE_URL=https://api.cerebras.ai/v1      AI_MODEL=gpt-oss-120b
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1    AI_MODEL=openai/gpt-oss-120b:free

# ── Privacy sidecar (Presidio) ── start with:  npm run privacy
PRESIDIO_URL=http://127.0.0.1:8790
# If the sidecar is down: "block" refuses AI calls (safe default), "builtin" uses built-in rules only
PII_FALLBACK=block

MAX_UPLOAD_MB=15

# Comma-separated emails that get the admin role when they register (admin panel: later phase)
ADMIN_EMAILS=

# ── Gmail (free Google OAuth client) ──
# console.cloud.google.com → new project → enable "Gmail API" → OAuth consent screen (External, Testing,
# add your Gmail as a test user) → Credentials → OAuth client ID → "Web application" →
# Authorized redirect URI: http://localhost:3100/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3100

# Optional: public HTTPS address for phones instead of `npm run phone` (e.g. a Cloudflare quick tunnel)
PUBLIC_URL=
